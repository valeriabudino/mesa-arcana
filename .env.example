APP_NAME="Mesa Arcana"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL del contenedor de Sail (compose.yaml). Son valores de desarrollo local.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=mesa_arcana
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database # la interpretación con IA corre en la cola: sail artisan queue:work

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Reverb (websockets). Estos valores alcanzan para desarrollo local;
# en un servidor real, usá valores propios y secretos.
REVERB_APP_ID=mesa-arcana
REVERB_APP_KEY=mesa-arcana-local
REVERB_APP_SECRET=cambiar-en-produccion
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Interpretación con IA (plan v3 §13.6). Sin clave se usa la interpretación con los significados de la base.
# Clave gratis en https://console.groq.com/keys
GROQ_API_KEY=
# Opcionales (estos son los valores por defecto). Después de cambiarlos, reiniciá queue:work.
# INTERPRETACION=ia                          # ia | base (base: nunca llama a la IA)
# INTERPRETACION_PROVEEDOR=groq
# INTERPRETACION_MODELO=openai/gpt-oss-120b
# INTERPRETACION_TIMEOUT=20                  # segundos antes de usar los significados de la base

# Créditos (plan v3 §13.2), por ahora ficticios. Los precios están en config/creditos.php.
# CREDITOS_REGALO=100                        # créditos de bienvenida de cada consultante (0 = sin regalo)
# CREDITOS_COMISION=20                       # % que se queda la plataforma de cada lectura cobrada

# Si algún puerto está ocupado (ver "Problemas comunes" en el README):
# APP_PORT=8000                              # y APP_URL=http://localhost:8000
# FORWARD_DB_PORT=3307
# REVERB_SERVER_PORT=8081                    # y VITE_REVERB_PORT=8081
